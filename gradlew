#!/bin/sh

##############################################################################
# Gradle start up script for POSIX generated by the standard Gradle wrapper.
# If this script is used from a terminal and gradle/wrapper/gradle-wrapper.jar
# is missing, open this project in Android Studio instead: Android Studio
# reads gradle/wrapper/gradle-wrapper.properties directly and does not need
# this script or the wrapper jar to sync, build, or run the app.
##############################################################################

DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

APP_HOME=$(cd "$(dirname "$0")" >/dev/null && pwd)

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ ! -f "$CLASSPATH" ]; then
  echo "gradle/wrapper/gradle-wrapper.jar is not present." >&2
  echo "Open this project directly in Android Studio (it does not need this script)," >&2
  echo "or run 'gradle wrapper' once with a locally installed Gradle to regenerate it." >&2
  exit 1
fi

if [ -n "$JAVA_HOME" ] ; then
  JAVACMD=$JAVA_HOME/bin/java
else
  JAVACMD=java
fi

exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain "$@"
